actor "Member" as Member
participant "ctl : LoanController" as ctl
participant "svc : LendingService" as svc
participant "loans : Loan[*]" as loans

Member -> ctl : 1: borrow(id, isbn)
activate ctl
ctl -> svc : 2: lend()
activate svc
loop for each open loan
alt overdue
svc -> loans : 3: isOverdue(today)
activate loans
loans --> svc : true
deactivate loans
else else
svc ->> loans : 4: isOverdue()
activate loans
deactivate loans
end
end
opt member wants a receipt
create participant "repo : LoanRepository" as repo
svc --> repo : 5: <<create>> LoanRepository()
activate repo
deactivate repo
svc -> repo : 6: findByMember(m)
activate repo
repo --> svc : loans
deactivate repo
svc -> repo : <<destroy>>
destroy repo
end
ref over Member, ctl : Pay fine
svc --> ctl : loan
deactivate svc
ctl --> Member
deactivate ctl
@enduml

