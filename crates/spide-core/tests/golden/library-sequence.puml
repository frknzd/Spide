actor "Member" as Member
participant ": LoanController" as LoanController
participant ": LendingService" as LendingService
participant ": LoanRepository" as LoanRepository

Member -> LoanController : 1: borrow(id, isbn)
activate LoanController
LoanController -> LendingService : 2: lend()
activate LendingService
LendingService -> LoanRepository : 3: save()
activate LoanRepository
LoanRepository --> LendingService : ok
deactivate LoanRepository
LendingService -[#FF5C6C]> LoanRepository : 4: explode() <color:#FF5C6C>✗ LoanRepository.explode() does not exist</color>
activate LoanRepository
LoanRepository --> LendingService
deactivate LoanRepository
LendingService --> LoanController : loan
deactivate LendingService
LoanController --> Member
deactivate LoanController
@enduml

