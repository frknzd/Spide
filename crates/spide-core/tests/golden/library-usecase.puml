@startuml
' use case diagram — exported from Spide
title Library system — Use case diagram
skinparam backgroundColor #1D1E22
skinparam defaultFontName "Helvetica Neue"
skinparam defaultFontColor #E6E8EE
skinparam titleFontColor #9AA1B1
skinparam shadowing false
skinparam roundCorner 12
skinparam classAttributeIconSize 0
hide circle
skinparam legend {
  BackgroundColor #25272D
  BorderColor #4B5263
  FontColor #9AA1B1
}
skinparam ArrowColor #8A93A6
skinparam ArrowFontColor #9AA1B1
skinparam ArrowFontSize 11
skinparam class {
  BackgroundColor #25272D
  HeaderBackgroundColor #2B2E35
  BorderColor #4B5263
  FontColor #E6E8EE
  FontStyle bold
  AttributeFontColor #E6E8EE
  AttributeFontName Menlo
  AttributeFontSize 12
  StereotypeFontColor #9AA1B1
}
skinparam package {
  BackgroundColor transparent
  FontColor #9AA1B1
  BorderColor #4B5263
}
skinparam note {
  BackgroundColor #2B2E35
  BorderColor #FFB454
  FontColor #E6E8EE
}
left to right direction
skinparam usecase {
  BackgroundColor #25272D
  BorderColor #7AA2FF
  FontColor #E6E8EE
}
skinparam actor {
  BorderColor #E6E8EE
  BackgroundColor #1D1E22
  FontColor #E6E8EE
}
skinparam rectangle {
  BorderColor #4B5263
  FontColor #9AA1B1
}

actor "Member" as A1
actor "Librarian" as A2
rectangle "Library" {
  usecase "Borrow book" as UC1
  usecase "Check availability" as UC2
  usecase "Manage catalog" as UC3
}
A1 -- UC1
UC1 ..> UC2 : <<include>>
A2 -- UC3
@enduml
