{
  "name": "spide",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "test:browser": "node scripts/browser-smoke.mjs && node scripts/terminal-browser-smoke.mjs && node scripts/ui-audit-smoke.mjs && node scripts/ghost-focus-smoke.mjs",
    "test:export": "node scripts/export-routing-smoke.mjs",
    "test:terminal": "python3 scripts/terminal_smoke.py",
    "tauri": "tauri",
    "app": ". \"$HOME/.cargo/env\" 2>/dev/null; tauri dev",
    "app:build": ". \"$HOME/.cargo/env\" 2>/dev/null; tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "d3-force": "^3.0.1",
    "elkjs": "^0.12.1",
    "framer-motion": "^14.13.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tauri-apps/cli": "^2.12.4",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.8"
  }
}
